# Copy to /opt/marketingai/.env on the droplet and fill in. NEVER commit it.

# Public hostname. Without a domain yet, use the droplet IP via sslip.io,
# e.g. droplet 164.90.1.2 -> 164-90-1-2.sslip.io (valid HTTPS cert, works
# as a Meta "app domain"). Switch to your own domain later.
APP_DOMAIN=

# Image deployed by GitHub Actions (it rewrites this line on every deploy).
APP_IMAGE=ghcr.io/OWNER/REPO:latest

# Postgres inside docker (not exposed publicly). Generate a long password:
#   openssl rand -hex 24
POSTGRES_USER=marketingai
POSTGRES_PASSWORD=
POSTGRES_DB=marketingai

# Same values as today's .env (keep ENCRYPTION_SECRET identical, or saved
# AI keys and Meta tokens become undecryptable).
BETTER_AUTH_SECRET=
ENCRYPTION_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
RESEND_API_KEY=
EMAIL_FROM=

# Leave unset: paid ads are frozen.
# FEATURE_ADS=

# AI video (docs/AI_VIDEO.md). All optional: unset = the defaults in code.
# Move every business that didn't pick a model to a new one:
# VIDEO_AI_DEFAULT_MODEL_GEMINI=
# VIDEO_AI_DEFAULT_MODEL_FAL=
# VIDEO_AI_DEFAULT_MODEL_OPENAI=
# Voice for scenes generated from an image. gpt-4o-mini-tts shuts down
# 2027-01-06 — set the replacement here when OpenAI names one.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin
