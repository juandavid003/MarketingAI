// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  name           String
  industry       String
  description    String
  targetAudience String
  location       String
  avgTicket      Float?
  objective      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Extended business profile (docs/DATA_MODEL.md). All optional so existing
  // businesses keep working; lib/businessContext.ts feeds whatever is filled
  // in to every AI prompt. Industry-agnostic by design: free text, no
  // per-industry columns.
  subIndustry      String?
  valueProposition String?
  serviceArea      String? // zonas de cobertura
  customerPersonas String? // perfiles de cliente ideal, texto libre
  brandTone        String?
  brandColors      String? // hex separados por coma, ej. "#0EA5E9, #111827"
  contentLanguage  String   @default("es")
  mainPlatforms    String[] @default([]) // instagram | facebook | tiktok | youtube
  preferredCtas    String?
  websiteUrl       String?
  whatsapp         String?
  contactEmail     String?
  businessGoals    String? // objetivos comerciales
  conversionGoal   String? // qué cuenta como conversión

  // AI provider chosen by this business's owner, with their own API key
  // (encrypted, see lib/crypto.ts) — never a key belonging to the platform.
  aiProvider        String?
  aiApiKeyEncrypted String?
  aiModel           String?
  aiConfiguredAt    DateTime?

  // Separate from aiApiKeyEncrypted: transcription (Whisper) is only offered
  // by OpenAI, regardless of which provider is chosen for text generation.
  openaiTranscriptionKeyEncrypted String?

  // Same idea for image generation (GPT Image), only offered by OpenAI.
  // When aiProvider is already "openai", aiApiKeyEncrypted is reused instead
  // of requiring this — see resolveOpenAiImageKey in actions.ts.
  openaiImageKeyEncrypted String?

  // Google Gemini key for the visual review of scene takes (it watches the
  // video: framing, light, focus, movement). Optional, client-owned.
  geminiApiKeyEncrypted String?

  // Brand logo (storage key), overlaid on assembled videos.
  logoPath String?

  products         Product[]
  socialConnection SocialConnection?
  campaigns        Campaign[]
  videoAssets      VideoAsset[]
  competitors      Competitor[]
  contentPieces    ContentPiece[]
  competitorIdeas  CompetitorIdeaBatch[]
  planItems        ContentPlanItem[]
  trackedLinks     TrackedLink[]
  promoCodes       PromoCode[]
  leads            Lead[]
  publishJobs      PublishJob[]
}

// name is a free-text search term, matched against the public Meta Ad
// Library web page (see lib/adLibrary.ts). instagramUsername, when set, is
// read through the official Business Discovery API
// (lib/competitorDiscovery.ts) — never scraped.

model Competitor {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  name       String
  createdAt  DateTime @default(now())

  instagramUsername String?
  followersCount    Int?
  mediaCount        Int?
  lastSyncedAt      DateTime?
  syncError         String?

  posts CompetitorPost[]
}

// A competitor's public post. source "instagram_api" = read from Business
// Discovery (metrics as reported by Instagram); "manual" = a reference the
// business owner registered themselves (metrics, if any, as they observed
// them). The UI always labels which is which.
model CompetitorPost {
  id            String     @id @default(cuid())
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  competitorId  String
  source        String // instagram_api | manual
  externalId    String? // Instagram media id
  permalink     String?
  caption       String?
  mediaType     String? // VIDEO | IMAGE | CAROUSEL_ALBUM | REELS ...
  likeCount     Int?
  commentsCount Int?
  postedAt      DateTime?
  notes         String? // manual only: what the owner noticed about it
  createdAt     DateTime   @default(now())

  @@unique([competitorId, externalId])
}

// AI-extracted patterns + video ideas from competitors' real posts. Every
// idea references the posts it came from (ids validated server-side, so the
// model can't cite a post that doesn't exist).
model CompetitorIdeaBatch {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  provider   String
  model      String
  content    String // JSON: GeneratedCompetitorIdeas
  createdAt  DateTime @default(now())
}

// One piece of content, generic across industries and sources: hook, scene-
// by-scene script (what to show / say / how to record), description,
// hashtags and CTAs. The owner records one take per scene; the studio checks
// each take and assembles the final video (lib/jobs/assemblePiece.ts).
model ContentPiece {
  id             String    @id @default(cuid())
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId     String?
  contentIndex   Int?
  sourceType     String // campaign | competitor_idea | brief
  sourceSummary  String
  sourceRefs     String? // JSON: [{ permalink, competitor, why }]
  purpose        String
  format         String
  hook           String
  content        String // JSON: GeneratedContentPiece (lib/ai.ts)
  provider       String
  model          String
  assemblyStatus String    @default("idle") // idle | assembling | ready | error
  assemblyError  String?
  // Distribution plan ("el distribuidor"): alternative hooks and CTAs for the
  // same body, the test design and a per-platform calendar. JSON
  // DistributionStrategy (lib/distribution.ts).
  strategy       String?
  // Captions + hashtags written per platform (JSON PlatformCopy[], lib/platformCopy.ts)
  platformCopy   String?
  // Background render of the creative variants: idle | rendering
  variantsStatus String    @default("idle")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  takes        SceneTake[]
  videoAssets  VideoAsset[]
  variants     CreativeVariant[]
  planItems    ContentPlanItem[]
  trackedLinks TrackedLink[]
  promoCodes   PromoCode[]
  leads        Lead[]
}

// One creative = the same recorded body with a given hook (opening) and CTA
// (closing), codes from ContentPiece.strategy: "H2C1" = hook H2 + CTA C1.
// Rendered videos are VideoAssets with this variantCode; a render is current
// while its VideoVersion.hook/cta still match the strategy text.
model CreativeVariant {
  id             String       @id @default(cuid())
  contentPiece   ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  contentPieceId String
  code           String
  hookCode       String
  ctaCode        String
  renderStatus   String       @default("idle") // idle | queued | rendering | ready | error
  renderError    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  results VariantResult[]

  @@unique([contentPieceId, code])
}

// Results the owner reads from each platform for one published creative.
// Entered by hand (organic posts); nothing here is estimated.
model VariantResult {
  id        String          @id @default(cuid())
  variant   CreativeVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String
  platform  String
  postUrl   String?
  postedAt  DateTime?
  views     Int?
  likes     Int?
  comments  Int?
  shares    Int?
  saves     Int?
  clicks    Int? // link clicks, messages or calls — the CTA response
  notes     String?
  createdAt DateTime        @default(now())
}

// The recording of one scene of a ContentPiece. Re-recording replaces it.
model SceneTake {
  id               String       @id @default(cuid())
  contentPiece     ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  contentPieceId   String
  sceneNumber      Int
  originalFilename String
  originalPath     String // storage key
  durationSeconds  Float?
  hasAudio         Boolean?
  status           String       @default("uploaded") // uploaded | processing | ready | error
  transcript       String? // JSON Transcript (lib/whisper.ts)
  keepIntervals    String? // JSON [[start, end], ...] after removing silences
  review           String? // JSON TakeReview (lib/takeReview.ts)
  errorMessage     String?
  // "main" = the script take; "hook:H2" = an alternative opening recorded
  // for hook H2 of the distribution plan (always scene 1).
  slot             String       @default("main")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  @@unique([contentPieceId, sceneNumber, slot])
}

model Campaign {
  id            String   @id @default(cuid())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String
  title         String
  sourceInsight String
  provider      String
  model         String
  content       String
  status        String   @default("draft")
  createdAt     DateTime @default(now())

  storyboards    Storyboard[]
  contentPieces  ContentPiece[]
  images         CampaignImage[]
  planItems      ContentPlanItem[]
  trackedLinks   TrackedLink[]
  promoCodes     PromoCode[]
  leads          Lead[]
  publishedPosts PublishedPost[]
  adCampaigns    AdCampaign[]
}

model PublishedPost {
  id             String   @id @default(cuid())
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String
  contentIndex   Int
  facebookPageId String
  pageName       String
  facebookPostId String
  permalinkUrl   String?
  message        String
  createdAt      DateTime @default(now())
}

// Boosts an already-published organic post (see PublishedPost) into a paid
// campaign via object_story_id — no separate creative/image upload needed.
// Every row here always starts (and is created in Meta as) PAUSED; only an
// explicit activateAdCampaign() call flips it to ACTIVE. Never auto-activated.

model AdCampaign {
  id               String   @id @default(cuid())
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId       String
  contentIndex     Int
  metaCampaignId   String
  metaAdSetId      String
  metaAdId         String
  metaCreativeId   String
  dailyBudgetCents Int
  status           String   @default("paused") // paused | active
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([campaignId, contentIndex])
}

model CampaignImage {
  id           String   @id @default(cuid())
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  contentIndex Int
  prompt       String
  imagePath    String
  provider     String
  model        String
  createdAt    DateTime @default(now())
}

model Storyboard {
  id           String   @id @default(cuid())
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  contentIndex Int
  hook         String
  format       String
  provider     String
  model        String
  scenes       String
  createdAt    DateTime @default(now())
}

model VideoAsset {
  id               String   @id @default(cuid())
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId       String
  originalFilename String
  originalPath     String // storage key (lib/storage.ts); legacy rows: "/uploads/..."
  durationSeconds  Float?
  status           String   @default("uploaded") // uploaded | transcribing | analyzing | rendering | ready | error
  transcript       String? // JSON: { segments: [{ start, end, text }] }
  errorMessage     String?
  createdAt        DateTime @default(now())
  // Bumped on every status change; lets the UI detect a job interrupted by a
  // server restart (see isStalled in lib/jobs/processVideo.ts).
  updatedAt        DateTime @default(now()) @updatedAt

  // Set when this video was assembled from a ContentPiece's scene takes.
  contentPiece   ContentPiece? @relation(fields: [contentPieceId], references: [id], onDelete: SetNull)
  contentPieceId String?
  // Set for renders of a CreativeVariant ("H2C1"); null for the base video.
  variantCode    String?

  versions VideoVersion[]
}

model VideoVersion {
  id            String     @id @default(cuid())
  videoAsset    VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  videoAssetId  String
  label         String
  outputPath    String
  thumbnailPath String?
  hook          String?
  cta           String?
  caption       String? // full post text (description + CTAs + hashtags), when known
  startSeconds  Float
  endSeconds    Float
  createdAt     DateTime   @default(now())

  publishedVideos PublishedVideo[]
  publishJobs     PublishJob[]
}

model PublishedVideo {
  id              String       @id @default(cuid())
  videoVersion    VideoVersion @relation(fields: [videoVersionId], references: [id], onDelete: Cascade)
  videoVersionId  String
  facebookPageId  String
  pageName        String
  facebookVideoId String
  permalinkUrl    String?
  message         String
  createdAt       DateTime     @default(now())
}

model Product {
  id         String   @id @default(cuid())
  name       String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  createdAt  DateTime @default(now())
}

model SocialConnection {
  id             String    @id @default(cuid())
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String    @unique
  provider       String    @default("meta")
  accessToken    String
  tokenExpiresAt DateTime?
  metaUserId     String
  metaUserName   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pages     SocialPage[]
  adAccount MetaAdAccount?
}

// A business connects at most one ad account — matches SocialConnection
// being 1:1 with Business today. ads_management calls (see lib/meta.ts) use
// SocialConnection.accessToken (the user token), not a page token.

model MetaAdAccount {
  id           String           @id @default(cuid())
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String           @unique
  adAccountId  String // e.g. "act_123456789"
  name         String
  currency     String
  createdAt    DateTime         @default(now())
}

model SocialPage {
  id                 String           @id @default(cuid())
  connection         SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId       String
  facebookPageId     String
  name               String
  pageAccessToken    String
  instagramAccountId String?
  instagramUsername  String?
  createdAt          DateTime         @default(now())

  @@unique([connectionId, facebookPageId])
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // "admin" (the platform owner, sees /admin, always treated as enabled) or
  // "client" (a paying customer). Set only server-side — see auth.ts's
  // additionalFields input: false.
  role String @default("client")

  // Manually flipped by the admin from /admin once a client's transfer
  // arrives — there is no payment gateway in this version. New accounts
  // start disabled until confirmed.
  enabled Boolean @default(false)

  sessions   Session[]
  accounts   Account[]
  businesses Business[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// `npx @better-auth/cli generate` resolves its own bundled (older) copy of
// better-auth's core schema logic rather than the version actually
// installed in this project, and that older copy predates the `issuer`
// field on Account — added by hand here, matching
// node_modules/@better-auth/core/src/db/get-tables.ts for the installed
// version (1.7.2), which is what actually runs at request time.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Manager de contenido: one publication on the calendar, any format.
// ---------------------------------------------------------------------------
model ContentPlanItem {
  id             String        @id @default(cuid())
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  date           DateTime // the day (stored at 12:00 UTC)
  time           String? // "18:30", optional
  platform       String // instagram | facebook | tiktok | youtube | other
  format         String // reel | carousel | story | post | video | live (lib/contentPlan.ts)
  title          String
  brief          String? // what the publication is about / how to make it
  copy           String? // caption
  details        String? // JSON string[]: carousel slides, story frames...
  pillar         String?
  purpose        String?
  status         String        @default("planned") // idea | planned | producing | ready | published
  source         String        @default("manual") // manual | ai | distribution
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId     String?
  contentPiece   ContentPiece? @relation(fields: [contentPieceId], references: [id], onDelete: SetNull)
  contentPieceId String?
  variantCode    String?
  trackedLink    TrackedLink?  @relation(fields: [trackedLinkId], references: [id], onDelete: SetNull)
  trackedLinkId  String?
  publishedUrl   String?
  publishJobs    PublishJob[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([businessId, date])
}

// ---------------------------------------------------------------------------
// Sprint 2 — business results: tracked links, promo codes, leads.
// ---------------------------------------------------------------------------

// /r/<slug> redirects to destinationUrl (UTM added) and counts the click.
model TrackedLink {
  id             String        @id @default(cuid())
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  slug           String        @unique
  label          String
  destinationUrl String
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId     String?
  contentPiece   ContentPiece? @relation(fields: [contentPieceId], references: [id], onDelete: SetNull)
  contentPieceId String?
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now())

  clicks    LinkClick[]
  leads     Lead[]
  planItems ContentPlanItem[]
}

// No personal data: no IP, no user agent, no cookie — only when, the kind of
// device and the referring site.
model LinkClick {
  id           String      @id @default(cuid())
  link         TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  linkId       String
  device       String? // mobile | tablet | desktop
  referrerHost String?
  createdAt    DateTime    @default(now())

  @@index([linkId, createdAt])
}

model PromoCode {
  id             String        @id @default(cuid())
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  code           String // stored uppercase
  description    String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId     String?
  contentPiece   ContentPiece? @relation(fields: [contentPieceId], references: [id], onDelete: SetNull)
  contentPieceId String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())

  leads Lead[]

  @@unique([businessId, code])
}

// A potential customer the owner registers. attribution says how sure we are
// of where they came from: high = tracked link or promo code, medium = the
// customer named the campaign/content, low = only a channel.
model Lead {
  id             String        @id @default(cuid())
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  name           String?
  contact        String?
  source         String // lib/leads.ts LEAD_SOURCES
  trackedLink    TrackedLink?  @relation(fields: [trackedLinkId], references: [id], onDelete: SetNull)
  trackedLinkId  String?
  promoCode      PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeId    String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId     String?
  contentPiece   ContentPiece? @relation(fields: [contentPieceId], references: [id], onDelete: SetNull)
  contentPieceId String?
  status         String        @default("new") // new | contacted | qualified | won | lost
  value          Float?
  attribution    String // high | medium | low
  notes          String?
  occurredAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([businessId, occurredAt])
}

// ---------------------------------------------------------------------------
// Sprint 4 — scheduled publishing. One row per (video version, destination,
// time). facebook_page / instagram_reels run automatically (lib/jobs/
// publishJobs.ts, polled every minute); "manual" is a reminder for networks
// without direct publishing (TikTok, YouTube...) that the owner marks done.
// ---------------------------------------------------------------------------
model PublishJob {
  id             String           @id @default(cuid())
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  videoVersion   VideoVersion     @relation(fields: [videoVersionId], references: [id], onDelete: Cascade)
  videoVersionId String
  planItem       ContentPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  planItemId     String?
  target         String // facebook_page | instagram_reels | manual
  socialPageId   String? // SocialPage.id for facebook_page / instagram_reels
  platform       String // facebook | instagram | tiktok | youtube | other (display + manual)
  caption        String
  scheduledAt    DateTime
  status         String           @default("scheduled") // scheduled | publishing | published | failed | canceled
  attempts       Int              @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  externalId     String?
  permalink      String?
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  @@index([status, scheduledAt])
  @@index([businessId, scheduledAt])
}
