// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  name           String
  industry       String
  description    String
  targetAudience String
  location       String
  avgTicket      Float?
  objective      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // AI provider chosen by this business's owner, with their own API key
  // (encrypted, see lib/crypto.ts) — never a key belonging to the platform.
  aiProvider        String?
  aiApiKeyEncrypted String?
  aiModel           String?
  aiConfiguredAt    DateTime?

  // Separate from aiApiKeyEncrypted: transcription (Whisper) is only offered
  // by OpenAI, regardless of which provider is chosen for text generation.
  openaiTranscriptionKeyEncrypted String?

  // Same idea for image generation (GPT Image), only offered by OpenAI.
  // When aiProvider is already "openai", aiApiKeyEncrypted is reused instead
  // of requiring this — see resolveOpenAiImageKey in actions.ts.
  openaiImageKeyEncrypted String?

  products         Product[]
  socialConnection SocialConnection?
  campaigns        Campaign[]
  videoAssets      VideoAsset[]
  competitors      Competitor[]
}

// Just a name/search term, not a Page ID — we have no way to look up a
// competitor's exact Page (no token for it). Matched against the public
// Meta Ad Library (see lib/adLibrary.ts), which needs only free text.

model Competitor {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  name       String
  createdAt  DateTime @default(now())
}

model Campaign {
  id            String   @id @default(cuid())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String
  title         String
  sourceInsight String
  provider      String
  model         String
  content       String
  status        String   @default("draft")
  createdAt     DateTime @default(now())

  storyboards    Storyboard[]
  images         CampaignImage[]
  publishedPosts PublishedPost[]
  adCampaigns    AdCampaign[]
}

model PublishedPost {
  id             String   @id @default(cuid())
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String
  contentIndex   Int
  facebookPageId String
  pageName       String
  facebookPostId String
  permalinkUrl   String?
  message        String
  createdAt      DateTime @default(now())
}

// Boosts an already-published organic post (see PublishedPost) into a paid
// campaign via object_story_id — no separate creative/image upload needed.
// Every row here always starts (and is created in Meta as) PAUSED; only an
// explicit activateAdCampaign() call flips it to ACTIVE. Never auto-activated.

model AdCampaign {
  id               String   @id @default(cuid())
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId       String
  contentIndex     Int
  metaCampaignId   String
  metaAdSetId      String
  metaAdId         String
  metaCreativeId   String
  dailyBudgetCents Int
  status           String   @default("paused") // paused | active
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([campaignId, contentIndex])
}

model CampaignImage {
  id           String   @id @default(cuid())
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  contentIndex Int
  prompt       String
  imagePath    String
  provider     String
  model        String
  createdAt    DateTime @default(now())
}

model Storyboard {
  id           String   @id @default(cuid())
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  contentIndex Int
  hook         String
  format       String
  provider     String
  model        String
  scenes       String
  createdAt    DateTime @default(now())
}

model VideoAsset {
  id               String   @id @default(cuid())
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId       String
  originalFilename String
  originalPath     String
  durationSeconds  Float?
  status           String   @default("uploaded") // uploaded | transcribing | analyzing | rendering | ready | error
  transcript       String? // JSON: { segments: [{ start, end, text }] }
  errorMessage     String?
  createdAt        DateTime @default(now())

  versions VideoVersion[]
}

model VideoVersion {
  id            String     @id @default(cuid())
  videoAsset    VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  videoAssetId  String
  label         String
  outputPath    String
  thumbnailPath String?
  hook          String?
  cta           String?
  startSeconds  Float
  endSeconds    Float
  createdAt     DateTime   @default(now())

  publishedVideos PublishedVideo[]
}

model PublishedVideo {
  id              String       @id @default(cuid())
  videoVersion    VideoVersion @relation(fields: [videoVersionId], references: [id], onDelete: Cascade)
  videoVersionId  String
  facebookPageId  String
  pageName        String
  facebookVideoId String
  permalinkUrl    String?
  message         String
  createdAt       DateTime     @default(now())
}

model Product {
  id         String   @id @default(cuid())
  name       String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  createdAt  DateTime @default(now())
}

model SocialConnection {
  id             String    @id @default(cuid())
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String    @unique
  provider       String    @default("meta")
  accessToken    String
  tokenExpiresAt DateTime?
  metaUserId     String
  metaUserName   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pages     SocialPage[]
  adAccount MetaAdAccount?
}

// A business connects at most one ad account — matches SocialConnection
// being 1:1 with Business today. ads_management calls (see lib/meta.ts) use
// SocialConnection.accessToken (the user token), not a page token.

model MetaAdAccount {
  id           String           @id @default(cuid())
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String           @unique
  adAccountId  String // e.g. "act_123456789"
  name         String
  currency     String
  createdAt    DateTime         @default(now())
}

model SocialPage {
  id                 String           @id @default(cuid())
  connection         SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId       String
  facebookPageId     String
  name               String
  pageAccessToken    String
  instagramAccountId String?
  instagramUsername  String?
  createdAt          DateTime         @default(now())

  @@unique([connectionId, facebookPageId])
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // "admin" (the platform owner, sees /admin, always treated as enabled) or
  // "client" (a paying customer). Set only server-side — see auth.ts's
  // additionalFields input: false.
  role String @default("client")

  // Manually flipped by the admin from /admin once a client's transfer
  // arrives — there is no payment gateway in this version. New accounts
  // start disabled until confirmed.
  enabled Boolean @default(false)

  sessions   Session[]
  accounts   Account[]
  businesses Business[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// `npx @better-auth/cli generate` resolves its own bundled (older) copy of
// better-auth's core schema logic rather than the version actually
// installed in this project, and that older copy predates the `issuer`
// field on Account — added by hand here, matching
// node_modules/@better-auth/core/src/db/get-tables.ts for the installed
// version (1.7.2), which is what actually runs at request time.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

