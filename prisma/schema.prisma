// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Business {
  id              String   @id @default(cuid())
  name            String
  industry        String
  description     String
  targetAudience  String
  location        String
  avgTicket       Float?
  objective       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // AI provider chosen by this business's owner, with their own API key
  // (encrypted, see lib/crypto.ts) — never a key belonging to the platform.
  aiProvider          String?
  aiApiKeyEncrypted   String?
  aiModel             String?
  aiConfiguredAt      DateTime?

  products         Product[]
  socialConnection SocialConnection?
  campaigns        Campaign[]
}

model Campaign {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  title          String
  sourceInsight  String
  provider       String
  model          String
  content        String
  status         String   @default("draft")
  createdAt      DateTime @default(now())
}

model Product {
  id         String   @id @default(cuid())
  name       String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  createdAt  DateTime @default(now())
}

model SocialConnection {
  id             String    @id @default(cuid())
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String    @unique
  provider       String    @default("meta")
  accessToken    String
  tokenExpiresAt DateTime?
  metaUserId     String
  metaUserName   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pages SocialPage[]
}

model SocialPage {
  id                  String           @id @default(cuid())
  connection          SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId        String
  facebookPageId      String
  name                String
  pageAccessToken     String
  instagramAccountId  String?
  instagramUsername   String?
  createdAt           DateTime         @default(now())

  @@unique([connectionId, facebookPageId])
}
